<?xml version="1.0" encoding="utf-8"?>
<!-- MD3 设置页：圆角列表项 + MaterialSwitch + 关于入口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- 顶部栏 -->
    <LinearLayout
        style="@style/CyrioTopBar"
        android:orientation="horizontal">

        <TextView
            style="@style/CyrioTopBarTitle"
            android:text="@string/tab_settings" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <!-- 设置项容器：16dp 外边距，列表项间 8dp 间距 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 设置项：上传默认应用拼音 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_setting_item"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/upload_apply_slug"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/md_on_surface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_default_slug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@android:color/transparent" />

        <!-- 设置项：上传默认应用去词 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_setting_item"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/upload_apply_strip"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/md_on_surface" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_default_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@android:color/transparent" />

        <!-- 设置项：关于（点击跳转） -->
        <LinearLayout
            android:id="@+id/item_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@drawable/bg_setting_item"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_about"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/md_on_surface" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_info"
                app:tint="@color/md_on_surface_variant"
                android:contentDescription="about" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
