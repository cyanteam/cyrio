<?xml version="1.0" encoding="utf-8"?>
<!-- 从左侧滑入（返回动画） -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate
        android:fromXDelta="-30%"
        android:toXDelta="0"
        android:duration="200" />
    <alpha
        android:fromAlpha="0.3"
        android:toAlpha="1.0"
        android:duration="200" />
</set>
