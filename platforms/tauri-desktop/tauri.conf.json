{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "cyrio-tauri",
    "version": "0.1.0",
    "identifier": "c.cyrio.tauri",
    "build": {
        "frontendDist": "frontend/dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": null,
        "beforeBuildCommand": null
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "title": "cyrio - Diamond Rio S-Series Manager",
                "width": 1024,
                "height": 720,
                "minWidth": 640,
                "minHeight": 480,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all"
    }
}
